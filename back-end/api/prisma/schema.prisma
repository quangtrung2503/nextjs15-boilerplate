// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DELETED
  BANNED
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id              Int             @id @default(autoincrement())
  email           String          @unique @db.VarChar(255)
  password        String
  phone           String?         @unique @db.VarChar(255)
  name            String          @db.VarChar(255)
  lastAccessToken String?         @db.Text
  fcmToken        String?         @db.Text
  nickName        String?         @db.VarChar(255)
  avatar          String?         @db.VarChar(255)
  role            UserRole        @default(CUSTOMER)
  sex             String?         @db.VarChar(255)
  dateOfBirth     DateTime?
  address         String?         @db.VarChar(255)
  status          UserStatus      @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")
  // relation
  Review          Review[]
  Post            Post[]
  Wishlist        Wishlist[]
  Booking         Booking[]
  RequestRefund   RequestRefund[]

  @@fulltext([email, phone, name, nickName])
  @@map("user")
}

model Video {
  id          Int     @id @default(autoincrement())
  title       String  @db.VarChar(255)
  description String  @db.Text
  thumbnail   String  @db.VarChar(255)
  video       String  @db.VarChar(255)
  isDisplay   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("video")
}

model City {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  image       String   @db.VarChar(255)
  description String   @db.Text
  isActive    Boolean  @default(true)
  slug        String   @unique @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // relation
  Tour    Tour[]
  CityTag CityTag[]

  @@map("city")
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(255)
  icon      String?   @db.VarChar(255)
  color     String    @db.VarChar(255)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  CityTag   CityTag[]

  @@map("tag")
}

model CityTag {
  id        Int      @id @default(autoincrement())
  cityId    Int
  tagId     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  City City @relation(fields: [cityId], references: [id], onDelete: Cascade)
  Tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([cityId, tagId])
  @@map("city_tag")
}

model Theme {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  isDisplay Boolean  @default(true)
  isActive  Boolean  @default(true)
  slug      String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // relation
  Tour Tour[]

  @@map("theme")
}

model Destination {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  isFeature Boolean  @default(false)
  isActive  Boolean  @default(true)
  slug      String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  TourDestination TourDestination[]

  @@map("destination")
}

model Tour {
  id             Int     @id @default(autoincrement())
  name           String  @db.VarChar(255)
  slug           String  @unique @db.VarChar(255)
  price          Float
  transport      String  @db.VarChar(255)
  package        String  @db.VarChar(255)
  numberOfHours  Int
  numberOfPeople Int
  isActive       Boolean @default(true)

  description         String @db.Text
  activity            String @db.Text
  included            String @db.Text
  notIncluded         String @db.Text
  safety              String @db.Text
  language            String @db.Text
  guideMeetingAddress String @db.Text

  cityId  Int
  themeId Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // relation fields
  City            City              @relation(fields: [cityId], references: [id])
  Theme           Theme             @relation(fields: [themeId], references: [id])
  Review          Review[]
  TourImage       TourImage[]
  Wishlist        Wishlist[]
  TourDestination TourDestination[]
  Booking         Booking[]

  @@fulltext([name])
  @@map("tour")
}

model TourDestination {
  id            Int @id @default(autoincrement())
  tourId        Int
  destinationId Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // relation fields
  Tour        Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  Destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([tourId, destinationId])
  @@map("tour_destination")
}

model TourImage {
  id        Int      @id @default(autoincrement())
  tourId    Int
  image     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // relation fields
  Tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@map("tour_image")
}

model Review {
  id                   Int      @id @default(autoincrement())
  userId               Int
  tourId               Int
  ratingGuide          Int
  ratingTransportation Int
  ratingValueOfMoney   Int
  ratingSafety         Int
  rating               Float
  title                String   @db.VarChar(255)
  content              String?  @db.Text
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  // relation fields
  User User @relation(fields: [userId], references: [id])
  Tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId])
  @@map("review")
}

model Post {
  id            Int      @id @default(autoincrement())
  userCreatedId Int
  image         String   @db.VarChar(255)
  title         String   @db.VarChar(255)
  content       String   @db.Text
  views         Int      @default(0)
  slug          String   @unique @db.VarChar(255)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  // relation fields
  User User @relation(fields: [userCreatedId], references: [id])

  @@map("post")
}

model Wishlist {
  id     Int @id @default(autoincrement())
  userId Int
  tourId Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // relation fields
  User User @relation(fields: [userId], references: [id])
  Tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId])
  @@map("wishlist")
}

model Booking {
  id               Int      @id @default(autoincrement())
  bookingCode      String   @unique @db.VarChar(255)
  userId           Int
  tourId           Int
  startDate        DateTime
  endDate          DateTime
  numberOfAdults   Int
  numberOfChildren Int
  totalPrice       Float
  status           String   @db.VarChar(255)
  paymentMethod    String   @db.VarChar(255)
  note             String?  @db.Text
  updatedBy        String?  @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  // relation fields
  User          User            @relation(fields: [userId], references: [id])
  Tour          Tour            @relation(fields: [tourId], references: [id])
  Payment       Payment[]
  RequestRefund RequestRefund[]

  @@map("booking")
}

model Payment {
  id                Int       @id @default(autoincrement())
  bookingId         Int
  paymentCode       String    @unique @db.VarChar(255)
  amount            Float
  bankCode          String?   @db.VarChar(50)
  bankTranNo        String?   @db.VarChar(255)
  cardType          String?   @db.VarChar(20)
  orderInfo         String?   @db.VarChar(255)
  expireDate        DateTime
  payDate           DateTime?
  responseCode      String?   @db.VarChar(10)
  transactionNo     String?   @db.VarChar(50)
  transactionStatus String    @db.VarChar(20)
  txnRef            String    @db.VarChar(255)
  secureHash        String?   @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  Booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payment")
}

model RequestRefund {
  id                Int      @id @default(autoincrement())
  bookingId         Int
  userId            Int
  reason            String   @db.VarChar(255)
  imageQRCode       String   @db.VarChar(255)
  accountHolderName String   @db.VarChar(255)
  accountNumber     String   @db.VarChar(255)
  bankName          String   @db.VarChar(255)
  status            String   @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy         String?  @db.VarChar(255)

  // Relations
  Booking Booking @relation(fields: [bookingId], references: [id])
  User    User    @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
  @@map("request_refund")
}
